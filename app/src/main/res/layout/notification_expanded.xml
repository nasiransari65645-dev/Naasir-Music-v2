<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="140dp"
    android:background="@android:color/transparent">

    <!-- Edge Lighting Dynamic Glowing Border Card (with concentric soundwave rings & rainbow border) -->
    <ImageView
        android:id="@+id/notification_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Notification Background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- Top Row: Album Artwork + Track Details + Branding -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- High-Res Album Artwork with Smooth Rounded Corners -->
            <ImageView
                android:id="@+id/notification_artwork"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerCrop"
                android:contentDescription="Album Art" />

            <!-- Title, Artist & App Branding -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/notification_app_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Naasir Music"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/notification_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Track Title"
                    android:textColor="#00E5FF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/notification_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Artist Name • Album"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Control Row: [ Shuffle ]  [ Previous ]  [ Play / Pause ]  [ Next ]  [ Repeat ] -->
        <LinearLayout
            android:id="@+id/notification_controls_row"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Shuffle Button -->
            <ImageButton
                android:id="@+id/btn_shuffle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_shuffle_off"
                android:scaleType="centerInside"
                android:contentDescription="Shuffle" />

            <!-- Previous Button -->
            <ImageButton
                android:id="@+id/btn_prev"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:contentDescription="Previous" />

            <!-- Play / Pause Button -->
            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:contentDescription="Play or Pause" />

            <!-- Next Button -->
            <ImageButton
                android:id="@+id/btn_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:contentDescription="Next" />

            <!-- Repeat Button -->
            <ImageButton
                android:id="@+id/btn_repeat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_repeat_off"
                android:scaleType="centerInside"
                android:contentDescription="Repeat" />
        </LinearLayout>

        <!-- Real-Time Touchable Seekbar Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="0dp">

            <!-- Real-time Progress Bar -->
            <ProgressBar
                android:id="@+id/notification_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_gravity="center_vertical"
                android:max="1000"
                android:progress="0"
                android:progressTint="#00E5FF"
                android:progressBackgroundTint="#334155" />

            <!-- Direct Touch-to-Seek Touch Zones (10 touch targets spanning 0% to 100%) -->
            <LinearLayout
                android:id="@+id/notification_seek_touch_row"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/seek_touch_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/seek_touch_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/seek_touch_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/seek_touch_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/seek_touch_5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/seek_touch_6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/seek_touch_7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/seek_touch_8"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/seek_touch_9"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/seek_touch_10"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />
            </LinearLayout>
        </FrameLayout>

        <!-- Elapsed & total time labels in crisp #94A3B8 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/tv_elapsed_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:gravity="start" />

            <TextView
                android:id="@+id/tv_total_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:gravity="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
